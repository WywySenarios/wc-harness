# Copy to .env and fill in. .env is gitignored; never commit real values.
# Base URL of an OpenAI-compatible API. A trailing /chat/completions is tolerated.
WC_LLM_BASE_URL=https://api.openai.com/v1
WC_LLM_MODEL=
WC_LLM_API_KEY=
# Optional. Sent as reasoning_effort; omit for providers that do not accept it.
WC_LLM_REASONING_EFFORT=
