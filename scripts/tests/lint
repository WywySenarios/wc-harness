#!/usr/bin/env bash
# Runs the static checks. Fails closed when a required tool is missing.

set -euo pipefail

REPO_ROOT="$(readlink -f "$(dirname "${BASH_SOURCE[0]}")/../..")"
cd "$REPO_ROOT"

if ! command -v go >/dev/null 2>&1; then
	echo "lint: go toolchain required (install go 1.24 or newer) — failing closed" >&2
	exit 1
fi

# Pinned and repo-local; the module cache makes later runs offline.
LINT=(go run github.com/golangci/golangci-lint/v2/cmd/golangci-lint@v2.15.0)

echo "==> go build ./..."
go build ./...
echo "    ok: go build ./..."

echo "==> go vet ./..."
go vet ./...
echo "    ok: go vet ./..."

echo "==> go mod verify"
go mod verify
echo "    ok: go mod verify"

echo "==> golangci-lint run"
"${LINT[@]}" run ./...
echo "    ok: golangci-lint run"
